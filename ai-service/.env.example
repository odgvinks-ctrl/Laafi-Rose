DATABASE_URL=postgresql+psycopg2://laafi:laafi@localhost:5432/laafi_ai

# Même valeur que backend/.env
JWT_SECRET=changez-moi-avec-une-cle-tres-longue-et-aleatoire

# Clé pour publier et modifier les documents
ADMIN_API_KEY=changez-moi

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# local : embeddings et réponses extractives sans modèle externe (développement)
# api : service compatible OpenAI (embeddings + chat), à renseigner ci-dessous
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=384

LLM_PROVIDER=local
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.15
