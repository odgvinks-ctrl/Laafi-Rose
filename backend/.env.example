# Copiez ce fichier en .env puis remplissez les valeurs.

DATABASE_URL=postgresql+psycopg2://laafi:laafi@localhost:5432/laafi_rose

# Clé forte : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changez-moi-avec-une-cle-tres-longue-et-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Alertes : minutes sans réponse avant de passer au niveau suivant
ALERT_ESCALATION_MINUTES=10
ALERT_CHECK_SECONDS=60
EMERGENCY_PHONE=

# SMS et serveur vocal (Laafi Voix) : laisser SMS_PROVIDER=console en développement
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=LaafiRose
